            color: var(--primary);
            font-weight: 500;
            transition: all 0.3s;
            position: relative;
        }
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--accent-red), var(--accent-green));
            transition: width 0.3s;
        }

        .nav-links a:hover::after {
